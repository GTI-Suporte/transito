<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>DER-PE | Sistema de Trânsito</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Tailwind CSS (CDN para garantir o estilo exato do mockup) -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .fade-in { animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes spin {
           0% { transform: rotate(0deg); }
           100% { transform: rotate(360deg); }
        }
        .spinner-rotativo {
            animation: spin 0.8s linear infinite;
        }
    </style>
  </head>

  <body class="text-slate-800 antialiased min-h-screen flex flex-col">
    <!-- Cabeçalho Oficial -->
    <header class="bg-[#003366] text-white shadow-md relative z-10">
        <div class="container mx-auto px-4 py-3 max-w-6xl flex items-center justify-between">
            
            <%= link_to root_path, class: "flex items-center gap-4 transition hover:opacity-90" do %>
                <!-- Caixa branca elegante destacando a logo oficial -->
                <div class="bg-white px-3 py-1.5 rounded-xl shadow-sm flex items-center justify-center shrink-0">
                    <%= image_tag "LOGO DER-PE ESCURA.png", alt: "Logomarca DER-PE", class: "h-12 w-auto object-contain" %>
                </div>
                
                <!-- Textos institucionais ao lado da logo -->
                <div class="flex flex-col text-white text-left">
                    <h1 class="text-xl font-bold tracking-wide leading-tight">DER-PE</h1>
                    <h2 class="text-xs text-blue-100 font-medium tracking-wide hidden sm:block">Departamento de Estradas de Rodagem de Pernambuco</h2>
                </div>
            <% end %>

        </div>
        
        <!-- Barra inferior com as cores institucionais (Verde e Amarelo) -->
        <div class="flex h-1.5 w-full">
          <div class="w-1/3 bg-[#8BC34A]"></div>
          <div class="w-2/3 bg-[#FFC107]"></div>
        </div>
    </header>

    <main class="flex-grow container mx-auto px-4 py-10 max-w-6xl relative">
      <%= yield %>
    </main>
  </body>
</html>
