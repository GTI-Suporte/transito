<nav class="bg-slate-900 text-white shadow-md border-b border-slate-700">
  <div class="container mx-auto px-4 max-w-6xl flex flex-wrap items-center justify-between py-3">
    
    <!-- Links de Navegação (Sem o mapa) -->
    <div class="flex items-center space-x-2 sm:space-x-4">
      
      <%= link_to admin_menu_index_path, class: "px-3 py-2 rounded-lg text-sm font-semibold transition hover:bg-slate-800 flex items-center gap-2 #{current_page?(admin_menu_index_path) ? 'bg-slate-800 text-amber-400' : 'text-slate-300'}" do %>
        <i class="ph-bold ph-squares-four text-lg"></i> Menu
      <% end %>

      <%= link_to admin_editais_path, class: "px-3 py-2 rounded-lg text-sm font-semibold transition hover:bg-slate-800 flex items-center gap-2 #{current_page?(admin_editais_path) ? 'bg-slate-800 text-amber-400' : 'text-slate-300'}" do %>
        <i class="ph-bold ph-file-text text-lg"></i> Editais
      <% end %>

      <%= link_to admin_equipamentos_path, class: "px-3 py-2 rounded-lg text-sm font-semibold transition hover:bg-slate-800 flex items-center gap-2 #{current_page?(admin_equipamentos_path) ? 'bg-slate-800 text-amber-400' : 'text-slate-300'}" do %>
        <i class="ph-bold ph-video-camera text-lg"></i> Equipamentos
      <% end %>



    </div>

    <!-- Identificação e Sair -->
    <div class="flex items-center gap-4">
      <span class="text-xs text-slate-400 hidden sm:flex items-center gap-1.5">
        <i class="ph-fill ph-user-circle text-lg"></i> <%= current_usuario.email %>
      </span>
      
      <%= button_to destroy_usuario_session_path, method: :delete, class: "bg-red-600/90 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-sm" do %>
        <i class="ph-bold ph-sign-out text-base"></i> Sair
      <% end %>
    </div>

  </div>
</nav>
