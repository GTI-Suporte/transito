<!-- app/views/admin/editais/index.html.erb -->
<%= turbo_stream_from "processamento_pdf" %>

<div class="fade-in">
    <!-- Mensagens de Alerta/Sucesso -->
    <% if notice %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert"><%= alert %></div>
    <% end %>

    <div class="flex items-center gap-3 mb-8">
        <i class="ph-fill ph-lock-key text-[#003366] text-3xl"></i>
        <div>
            <h2 class="text-2xl font-bold text-slate-800">Painel do Administrador</h2>
            <p class="text-slate-500">Alimentação do banco de dados de infrações via PDFs do Diário Oficial.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Formulário de Upload -->
        <div class="lg:col-span-1 bg-white rounded-xl shadow-md border border-slate-200 p-6 h-fit">
            <h3 class="text-lg font-bold text-slate-800 mb-4 border-b pb-2">Novo Processamento</h3>
            
            <!-- AQUI ESTÁ A PRIMEIRA CORREÇÃO: data: { turbo: true } adicionado -->
            <%= form_with url: admin_editais_path, multipart: true, class: "space-y-5", data: { turbo: true } do |f| %>
                <div>
                    <%= f.label :tipo, "Tipo de Edital", class: "block text-sm font-semibold text-slate-700 mb-1" %>
                    <%= f.select :tipo, [['Penalidade de Multa', 'penalidade'], ['Autuação', 'autuacao']], {}, class: "w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] outline-none" %>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Ficheiro PDF (Diário Oficial)</label>
                    <%= f.file_field :file, accept: ".pdf", class: "w-full p-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-[#003366] hover:file:bg-blue-100", required: true %>
                </div>
                
                <div>
                    <%= f.label :data_publicacao, "Data de Publicação", class: "block text-sm font-semibold text-slate-700 mb-1" %>
                    <%= f.date_field :data_publicacao, value: Date.today, class: "w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] outline-none", required: true %>
                </div>

                <div class="relative">
                    <%= button_tag type: 'submit', id: 'btnProcessar', class: "w-full bg-[#003366] hover:bg-blue-800 text-white font-bold py-3 rounded-lg shadow transition flex justify-center items-center gap-2 cursor-pointer" do %>
                        <i class="ph ph-database text-lg"></i> Processar e Alimentar Base
                    <% end %>
                </div>
            <% end %>
        </div>

        <!-- Estatísticas e Histórico -->
        <div class="lg:col-span-2 space-y-6">
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
                    <div class="bg-blue-100 p-3 rounded-lg text-blue-700"><i class="ph-fill ph-files text-2xl"></i></div>
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Editais Processados</p>
                        <p class="text-2xl font-bold text-slate-800"><%= @total_editais %></p>
                    </div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
                    <div class="bg-red-100 p-3 rounded-lg text-red-700"><i class="ph-fill ph-car-profile text-2xl"></i></div>
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Placas na Base</p>
                        <p class="text-2xl font-bold text-slate-800"><%= @total_placas %></p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden">
                <div class="p-4 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                    <h3 class="font-bold text-slate-800">Últimos Processamentos</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50 text-xs uppercase text-slate-500 border-b">
                            <tr>
                                <th class="px-6 py-3">Arquivo</th>
                                <th class="px-6 py-3">Tipo</th>
                                <th class="px-6 py-3">Data Publ.</th>
                                <th class="px-6 py-3">Registos</th>
                                <th class="px-6 py-3">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @editais.each do |edital| %>
                              <% badge_class = edital.tipo == 'penalidade' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700' %>
                              <tr class="border-b hover:bg-slate-50">
                                  <td class="px-6 py-4 font-medium text-slate-800 truncate max-w-[200px]" title="<%= edital.arquivo_nome %>"><%= edital.arquivo_nome %></td>
                                  <td class="px-6 py-4"><span class="<%= badge_class %> px-2 py-1 rounded text-xs font-bold uppercase"><%= edital.tipo %></span></td>
                                  <td class="px-6 py-4"><%= edital.data_publicacao&.strftime("%d/%m/%Y") %></td>
                                  <td class="px-6 py-4 font-mono"><%= edital.infracoes.count %></td>
                                  <td class="px-6 py-4">
                                      <%= button_to "/admin/editais/#{edital.id}", method: :delete, form: { data: { turbo_confirm: "Tem a certeza que deseja apagar este edital e remover as suas infrações?" } }, class: "text-red-500 hover:text-red-700 font-semibold flex items-center gap-1 cursor-pointer" do %>
                                           <i class="ph-fill ph-trash"></i> Apagar
                                      <% end %>
                                  </td>
                              </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ecrã de Carregamento Estático com Barra de Progresso Animada -->
<div id="loadingOverlay" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center">
    <div class="bg-white rounded-2xl p-8 max-w-md w-full mx-4 text-center shadow-2xl border border-slate-100">
        <div class="w-16 h-16 bg-blue-50 text-[#003366] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="animate-spin w-8 h-8 text-[#003366]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-800 mb-2">Carregando...</h3>
        
        <p class="text-sm text-slate-500 mb-6">
            Por favor, aguarde. Este processo pode demorar alguns minutos.
        </p>

        <!-- Barra de Progresso Estilo Bootstrap -->
        <div class="w-full bg-slate-200 rounded-full h-4 mb-2 overflow-hidden shadow-inner">
            <div id="barraProgresso" class="bg-blue-600 h-4 rounded-full transition-all duration-700 ease-out" style="width: 0%"></div>
        </div>
        
        <!-- Texto da Percentagem -->
        <p id="textoProgresso" class="text-sm font-bold text-blue-700">0%</p>
    </div>
</div>

<script>
  document.addEventListener('submit', function(event) {
    if (event.target.checkValidity()) {
        document.getElementById('loadingOverlay').classList.remove('hidden');
        
        let barra = document.getElementById('barraProgresso');
        let texto = document.getElementById('textoProgresso');
        let progresso = 0;

        let intervalo = setInterval(function() {
            
            if (progresso < 40) {
                progresso += Math.floor(Math.random() * 8) + 2; 
            } else if (progresso < 75) {
                progresso += Math.floor(Math.random() * 4) + 1;
            } else if (progresso < 95) {
                progresso += 1;
            } else {
                progresso = 98;
            }

            if (progresso > 98) progresso = 98;

            barra.style.width = progresso + "%";
            texto.innerText = progresso + "% (Processando...)";
            
        }, 600); 
    }
  });
</script>
