<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Voltar para equipamentos", admin_equipamentos_path, class: "text-sm font-semibold text-[#003366] hover:underline" %>
    <h1 class="text-2xl font-bold text-slate-800 mt-3">Novo equipamento</h1>
    <p class="text-sm text-slate-500 mt-1">Cadastre uma câmera, lombada, equipamento misto ou rede semafórica.</p>
  </div>

  <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6">
    <%= render "form", equipamento: @equipamento %>
  </div>
</div>
