<div class="max-w-6xl mx-auto">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Equipamentos</h1>
      <p class="text-sm text-slate-500 mt-1">Gerenciamento dos equipamentos de fiscalização.</p>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to "Ver mapa", root_path,
          class: "px-4 py-2 rounded-lg border border-slate-200 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition" %>

      <%= link_to "Novo equipamento", new_admin_equipamento_path,
          class: "px-4 py-2 rounded-lg bg-[#003366] text-white font-semibold text-sm hover:bg-blue-800 transition shadow" %>

      <%= button_to "Sair", destroy_usuario_session_path,
          method: :delete,
          class: "px-4 py-2 rounded-lg bg-slate-100 text-slate-700 font-semibold text-sm hover:bg-slate-200 transition" %>
    </div>
  </div>

  <% if notice %>
    <div class="bg-green-50 text-green-700 border border-green-200 px-4 py-3 rounded-lg mb-5 text-sm">
      <%= notice %>
    </div>
  <% end %>

  <% if alert %>
    <div class="bg-red-50 text-red-700 border border-red-200 px-4 py-3 rounded-lg mb-5 text-sm">
      <%= alert %>
    </div>
  <% end %>

  <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-200">
      <strong class="text-slate-800"><%= @equipamentos.count %></strong>
      <span class="text-sm text-slate-500">equipamentos cadastrados</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="p-3 text-left font-semibold text-slate-600">Identificação</th>
            <th class="p-3 text-left font-semibold text-slate-600">Tipo</th>
            <th class="p-3 text-left font-semibold text-slate-600">Endereço</th>
            <th class="p-3 text-left font-semibold text-slate-600">Latitude</th>
            <th class="p-3 text-left font-semibold text-slate-600">Longitude</th>
            <th class="p-3 text-center font-semibold text-slate-600">Ações</th>
          </tr>
        </thead>

        <tbody>
          <% @equipamentos.each do |equipamento| %>
            <tr class="border-t border-slate-100 hover:bg-slate-50/70">
              <td class="p-3 font-semibold text-slate-800"><%= equipamento.identificacao %></td>
              <td class="p-3 text-slate-600"><%= equipamento.tipo %></td>
              <td class="p-3 text-slate-600 min-w-[280px]"><%= equipamento.endereco %></td>
              <td class="p-3 text-slate-600"><%= equipamento.latitude || "—" %></td>
              <td class="p-3 text-slate-600"><%= equipamento.longitude || "—" %></td>
              <td class="p-3">
                <div class="flex items-center justify-center gap-3">
                  <%= link_to "Editar", edit_admin_equipamento_path(equipamento),
                      class: "text-blue-600 font-semibold hover:underline" %>

                  <%= button_to "Excluir", admin_equipamento_path(equipamento),
                      method: :delete,
                      data: { turbo_confirm: "Tem certeza que deseja excluir este equipamento?" },
                      class: "text-red-600 font-semibold hover:underline bg-transparent border-0 cursor-pointer p-0" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
