<%= form_with model: [:admin, equipamento], class: "space-y-6" do |f| %>
  <% if equipamento.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-semibold mb-2">
        Não foi possível salvar o equipamento:
      </p>

      <ul class="list-disc pl-5 space-y-1">
        <% equipamento.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

    <!-- IDENTIFICAÇÃO -->
    <div>
      <%= f.label :identificacao,
          "Identificação",
          class: "block text-sm font-semibold text-slate-700 mb-1" %>

      <%= f.text_field :identificacao,
          class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none",
          placeholder: "Ex.: DERPE1348" %>
    </div>

    <!-- TIPO -->
    <div>
      <%= f.label :tipo,
          "Tipo",
          class: "block text-sm font-semibold text-slate-700 mb-1" %>

      <%= f.select :tipo,
          options_for_select(
            Equipamento::TIPOS.map do |tipo|
              [
                Equipamento::TIPO_LABELS.fetch(tipo, tipo),
                tipo
              ]
            end,
            equipamento.tipo
          ),
          {
            include_blank: "Selecione o tipo"
          },
          {
            id: "equipamento-tipo",
            class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none"
          } %>
    </div>

    <!-- CLASSIFICAÇÃO DO SEMÁFORO -->
    <div
      id="subtipo-semaforo-container"
      class="<%= equipamento.tipo == 'Rede Semafórica' ? '' : 'hidden' %>"
    >
      <%= f.label :subtipo_semaforo,
          "Classificação do semáforo",
          class: "block text-sm font-semibold text-slate-700 mb-1" %>

      <%= f.select :subtipo_semaforo,
          options_for_select(
            [
              ["Não classificado", ""]
            ] +
            Equipamento::SUBTIPOS_SEMAFORO.map do |tipo|
              [tipo, tipo]
            end,
            equipamento.subtipo_semaforo
          ),
          {},
          {
            id: "equipamento-subtipo-semaforo",
            class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none"
          } %>

      <p class="text-xs text-slate-500 mt-1">
        Classificação utilizada somente para equipamentos da rede semafórica.
      </p>
    </div>

  </div>

  <!-- ENDEREÇO -->
  <div>
    <%= f.label :endereco,
        "Endereço / localização",
        class: "block text-sm font-semibold text-slate-700 mb-1" %>

    <%= f.text_area :endereco,
        rows: 3,
        class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none",
        placeholder: "Rodovia, km, avenida, cruzamento ou referência" %>
  </div>

  <!-- COORDENADAS -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

    <div>
      <%= f.label :latitude,
          "Latitude",
          class: "block text-sm font-semibold text-slate-700 mb-1" %>

      <%= f.number_field :latitude,
          step: :any,
          class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none",
          placeholder: "-8.000000" %>
    </div>

    <div>
      <%= f.label :longitude,
          "Longitude",
          class: "block text-sm font-semibold text-slate-700 mb-1" %>

      <%= f.number_field :longitude,
          step: :any,
          class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none",
          placeholder: "-34.900000" %>
    </div>

  </div>

  <!-- BOTÕES -->
  <div class="flex flex-wrap gap-3 pt-2">

    <%= f.submit equipamento.persisted? ? "Salvar alterações" : "Cadastrar equipamento",
        class: "inline-flex items-center justify-center gap-2 bg-[#003366] hover:bg-blue-800 text-white font-bold py-3 px-5 rounded-lg shadow transition cursor-pointer" %>

    <%= link_to admin_equipamentos_path,
        class: "inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3 px-5 rounded-lg transition" do %>

      Cancelar

    <% end %>

  </div>
<% end %>

<script>
  function configurarSubtipoSemaforo() {
    const tipo =
      document.getElementById("equipamento-tipo");

    const container =
      document.getElementById(
        "subtipo-semaforo-container"
      );

    const subtipo =
      document.getElementById(
        "equipamento-subtipo-semaforo"
      );

    if (!tipo || !container || !subtipo) {
      return;
    }

    // Evita registrar o mesmo evento mais de uma vez
    // quando o Turbo carregar a página novamente.
    if (tipo.dataset.subtipoReady === "true") {
      return;
    }

    tipo.dataset.subtipoReady = "true";

    function atualizarSubtipo() {
      const ehSemaforo =
        tipo.value === "Rede Semafórica";

      container.classList.toggle(
        "hidden",
        !ehSemaforo
      );

      if (!ehSemaforo) {
        subtipo.value = "";
      }
    }

    tipo.addEventListener(
      "change",
      atualizarSubtipo
    );

    atualizarSubtipo();
  }

  document.addEventListener(
    "DOMContentLoaded",
    configurarSubtipoSemaforo,
    { once: true }
  );

  document.addEventListener(
    "turbo:load",
    configurarSubtipoSemaforo
  );
</script>