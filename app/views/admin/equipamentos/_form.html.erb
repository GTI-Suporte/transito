<%= form_with model: [:admin, equipamento], class: "space-y-6" do |f| %>
  <% if equipamento.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-semibold mb-2">Não foi possível salvar o equipamento:</p>
      <ul class="list-disc pl-5 space-y-1">
        <% equipamento.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <%= f.label :identificacao, "Identificação", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= f.text_field :identificacao,
          class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none",
          placeholder: "Ex.: DERPE1348" %>
    </div>

    <div>
      <%= f.label :tipo, "Tipo", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= f.select :tipo,
          options_for_select(Equipamento::TIPOS, equipamento.tipo),
          { include_blank: "Selecione o tipo" },
          class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none" %>
    </div>
  </div>

  <div>
    <%= f.label :endereco, "Endereço / localização", class: "block text-sm font-semibold text-slate-700 mb-1" %>
    <%= f.text_area :endereco,
        rows: 3,
        class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none",
        placeholder: "Rodovia, km, avenida, cruzamento ou referência" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <%= f.label :latitude, "Latitude", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= f.number_field :latitude,
          step: :any,
          class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none",
          placeholder: "-8.000000" %>
    </div>

    <div>
      <%= f.label :longitude, "Longitude", class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= f.number_field :longitude,
          step: :any,
          class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] focus:border-[#003366] outline-none",
          placeholder: "-34.900000" %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3 pt-2">
    <%= f.submit equipamento.persisted? ? "Salvar alterações" : "Cadastrar equipamento",
        class: "bg-[#003366] hover:bg-blue-800 text-white font-bold py-3 px-5 rounded-lg shadow transition cursor-pointer" %>

    <%= link_to "Cancelar",
        admin_equipamentos_path,
        class: "bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3 px-5 rounded-lg transition" %>
  </div>
<% end %>
