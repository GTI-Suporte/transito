<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard de Fiscalização de Trânsito - Pernambuco</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <%= stylesheet_link_tag "dashboard", "data-turbo-track": "reload" %>
</head>
<body>


    <div id="sidebar">
        <div class="header">
            <h1><i class="fas fa-shield-halved"></i> Controle de Trânsito</h1>
            <p>Pernambuco — Gestão de Equipamentos de Fiscalização</p>
        </div>
        
        <div class="stats-container">
            <div class="stat-card">
                <div class="stat-header">
                    <span>Total</span>
                    <i class="fas fa-layer-group" style="color: var(--primary)"></i>
                </div>
                <h3 id="total-count">0</h3>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <span>Câmeras</span>
                    <i class="fas fa-camera" style="color: var(--accent-camera)"></i>
                </div>
                <h3 id="dome-count">0</h3>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <span>Mistos</span>
                    <i class="fas fa-video" style="color: var(--accent-misto)"></i>
                </div>
                <h3 id="misto-count">0</h3>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <span>Semáforos</span>
                    <i class="fas fa-traffic-light" style="color: var(--accent-semaforo)"></i>
                </div>
                <h3 id="semaforo-count">0</h3>
            </div>
        </div>

        <div class="search-box">
            <i class="fas fa-search search-icon"></i>
            <input type="text" id="search-input" placeholder="Buscar por endereço, rodovia ou ID...">
        </div>

        <div class="filters">
            <span class="filter-label">Filtrar por Categoria</span>
            <div class="filter-group" id="category-filters">
                <!-- Filtros gerados dinamicamente via JS -->
            </div>
        </div>

        <div class="results-header">
            <span>Resultados</span>
            <span id="results-count">0 itens</span>
        </div>

        <div class="results-list" id="results-list">
            <div class="loading"><i class="fas fa-spinner fa-spin"></i> Carregando dados...</div>
        </div>
    </div>

    <div id="map"></div>

    <%= javascript_importmap_tags %>
</body>
</html>
