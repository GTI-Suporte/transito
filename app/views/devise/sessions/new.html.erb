<div class="flex items-center justify-center min-h-[70vh]">
  <div class="bg-white p-8 rounded-xl shadow-md border border-slate-200 w-full max-w-md fade-in">
    
    <div class="text-center mb-8">
      <div class="w-16 h-16 bg-blue-50 text-[#003366] rounded-full flex items-center justify-center mx-auto mb-4">
        <i class="ph-fill ph-shield-check text-3xl"></i>
      </div>
      <h2 class="text-2xl font-bold text-slate-800">Acesso Restrito</h2>
      <p class="text-sm text-slate-500 mt-1">Insira as suas credenciais para gerir os editais</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, "E-mail Institucional", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] outline-none", placeholder: "nome@der.pe.gov.br" %>
      </div>

      <div>
        <%= f.label :password, "Palavra-passe", class: "block text-sm font-semibold text-slate-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-[#003366] outline-none", placeholder: "••••••••" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center justify-between mt-2">
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-[#003366] focus:ring-[#003366] border-slate-300 rounded cursor-pointer" %>
            <%= f.label :remember_me, "Lembrar-me", class: "ml-2 block text-sm text-slate-600 cursor-pointer" %>
          </div>
          
          <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
            <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-sm font-semibold text-[#003366] hover:text-blue-800 hover:underline transition" %>
          <% end %>
        </div>
      <% end %>

      <div class="pt-4">
        <%= button_tag type: 'submit', class: "w-full bg-[#003366] hover:bg-blue-800 text-white font-bold py-3 rounded-lg shadow transition flex justify-center items-center gap-2 cursor-pointer" do %>
          <i class="ph-bold ph-sign-in text-lg"></i> Entrar no Sistema
        <% end %>
      </div>
    <% end %>
    
  </div>
</div>
